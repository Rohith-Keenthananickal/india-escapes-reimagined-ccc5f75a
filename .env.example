# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID (Google Identity Services — exposed to the browser)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google OAuth client secret (backend / local reference only — do NOT prefix with VITE_)
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Cashfree Checkout.js mode (sandbox | production). App ID comes from checkout API response.
VITE_CASHFREE_MODE=sandbox
